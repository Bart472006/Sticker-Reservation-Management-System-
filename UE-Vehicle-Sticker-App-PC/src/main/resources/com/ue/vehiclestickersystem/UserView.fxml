<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="740.0" prefWidth="1200.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ue.vehiclestickersystem.PortalController">
    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="230.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
            <!-- Red UE Brand Header -->
            <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #b71c1c; -fx-padding: 18 20;">
                <ImageView fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@assets/ue_logo.png" />
                    </image>
                </ImageView>
                <VBox spacing="2.0">
                    <Label style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px;" text="UE Campus Pass" />
                    <Label style="-fx-text-fill: #fecdd3; -fx-font-size: 10.5px;" text="User Portal • AY 2026-2027" />
                </VBox>
            </HBox>

            <!-- Navigation Buttons -->
            <VBox spacing="8.0" style="-fx-padding: 18 14;">
                <Button fx:id="btnNavDashboard" maxWidth="Infinity" onAction="#showStudentDashboard" styleClass="nav-button-active" text="⊞  Dashboard" />
                <Button fx:id="btnNavInbox" maxWidth="Infinity" onAction="#showUserInbox" styleClass="nav-button" text="✉  Inbox" />
                <Button fx:id="btnNavSupport" maxWidth="Infinity" onAction="#showUserSupport" styleClass="nav-button" text="?  Pickup &amp; Support" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom Logout Button -->
            <VBox style="-fx-padding: 14; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;">
                <Button maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #b71c1c; -fx-font-weight: bold; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14; -fx-cursor: hand;" text="↪  Logout" />
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT AREA WITH DASHBOARD BACKGROUND -->
    <center>
        <StackPane style="-fx-background-color: #e2e8f0;">
            <Region styleClass="user-workspace-bg" />

            <ScrollPane fx:id="userScrollPane" fitToWidth="true" fitToHeight="false" styleClass="transparent-scroll">
                <content>
                    <!-- Populated dynamically by PortalController (Dashboard, Inbox, Support) -->
                    <VBox fx:id="userContentRoot" spacing="18.0" style="-fx-padding: 26 32; -fx-background-color: transparent;" />
                </content>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>